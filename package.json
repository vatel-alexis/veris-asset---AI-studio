{
  "name": "veris-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@veris/shared --if-present",
    "dev": "npm run dev --workspace=@veris/web",
    "build": "npm run build --workspace=@veris/web",
    "start": "npm run start --workspace=@veris/web",
    "preview": "npm run start --workspace=@veris/web",
    "lint": "npm run lint --workspace=@veris/web"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1"
  }
}